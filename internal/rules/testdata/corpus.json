          "chain": [{"subject": "CN=host", "issuer": "CN=Real CA", "not_before": "2026-01-01T00:00:00Z", "not_after": "2027-06-01T00:00:00Z", "self_signed": false, "public_key_algorithm": "RSA", "key_bits": 2048}]}
