# CVAP single-node deployment configuration.
#
# Copy to deploy/.env and set real values. deploy/.env is gitignored (the root
# .gitignore's `.env` rule matches it) and must never be committed.
#
# Nothing here is a production default. Core holds a map of a customer's
# weaknesses and credentials to their estate, so a shipped password is not a
# rough edge, it is the compromise. Generate every secret below.

# --- PostgreSQL (the migration/superuser role) ---
POSTGRES_USER=cvap
POSTGRES_PASSWORD=CHANGE-ME-generate-a-strong-password
POSTGRES_DB=cvap

# --- The application role's password ---
# cvap-core connects as cvap_app_login with this. Provisioned by
# provision-app-role.sql on first `up`; RLS applies to this role (it holds
# neither BYPASSRLS nor SUPERUSER). Different from POSTGRES_PASSWORD.
APP_ROLE_PASSWORD=CHANGE-ME-generate-a-different-strong-password

# --- MinIO (evidence and reports, ADR-015) ---
MINIO_ROOT_USER=cvap
MINIO_ROOT_PASSWORD=CHANGE-ME-generate-a-strong-password
MINIO_BUCKET=cvap-evidence

# --- Addressing ---
# The address a scan point uses to reach THIS host. Core advertises it at
# enrollment, so it must be resolvable and routable from where scan points run —
# the host's DNS name or LAN IP, NOT localhost or a container name. There is no
# sensible default; set it.
CVAP_ADVERTISE_HOST=cvap.internal.example.com

# Which host interface the published ports bind to. Default is all interfaces;
# set to a specific address to restrict where Core is reachable from.
CVAP_BIND_ADDR=0.0.0.0

# --- Operator login ---
# Local password auth. Kept on here because a single-node on-prem install is the
# case it exists for; set to 0 to require SSO instead (configured per tenant).
CVAP_CORE_LOCAL_AUTH=1

# Session lifetime in seconds. Default 8h; 12h is the hard maximum (a CHECK
# constraint enforces it and Core refuses a larger value at startup).
CVAP_CORE_SESSION_TTL_SECONDS=28800

# --- Logging / build ---
# debug | info | warn | error
LOG_LEVEL=info
# Stamped into the built image and reported by every binary.
CVAP_VERSION=dev
