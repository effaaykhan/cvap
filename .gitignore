# build
/bin/
/dist/
*.exe
*.test
*.out
coverage.*

# python
__pycache__/
*.py[cod]
.venv/
venv/

# local claude config (personal overrides, not shared)
.claude/settings.local.json
.claude/agent-memory-local/

# secrets — never commit
.env
.env.*

# No negation here on purpose. The committed template is `env.example`, with no
# leading dot, so it does not match the patterns above and needs no exception.
# `.env.example` therefore stays ignored like every other .env.* file — if one
# appears it is somebody's real config, not the template.
*.pem
*.key
*.p12
/secrets/
# The WHOLE deploy/secrets/ directory, not deploy/secrets/*.key. Ignoring only
# key files was correct until a public cert (ca.crt) landed there uncommitted and
# a `git add -A` would have taken it: a rule that names the extensions it knows
# about lets the next artifact through. The directory holds nothing that belongs
# in the repo, so ignore all of it.
deploy/secrets/

# lab artifacts
/lab/captures/
/lab/output/

# editors
.idea/
.vscode/
*.swp
.go.mod.tidycheck
.go.sum.tidycheck
.safety-scope.sabotage
