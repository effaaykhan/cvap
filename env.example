# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Named env.example, without a leading dot, deliberately. The deny rule that
# stops tooling reading real env files is a single glob, `**/.env.*`, and a
# committed template whose name matches it forces the glob to be replaced by an
# enumeration of the names anyone thought of. That enumeration then misses
# .env.prod, .env.ci, .env.backup and whatever gets created next year. One
# filename without a dot is cheaper than a control that decays.
#
# These are DEVELOPMENT credentials for the local Compose stack only. Nothing
# here is a production default: Core holds a map of a customer's weaknesses
# plus credentials to their estate, so a shipped default password is not a
# rough edge, it is the whole compromise.

# --- PostgreSQL (ADR-002: system of record) ---
POSTGRES_USER=cvap
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=cvap
POSTGRES_PORT=5432

# The MIGRATION role. Owns the schema, runs `make migrate-up`, and is the only
# identity that may bypass RLS. Never used by the running application.
DATABASE_URL=postgres://cvap:change-me-locally@localhost:5432/cvap?sslmode=disable

# The APPLICATION role. cvap-core connects as this: a LOGIN role in the cvap_app
# group, holding neither BYPASSRLS nor SUPERUSER, so RLS applies to it (ADR-002).
# Created by internal/store/testdata/app_role.sql (`make app-role`) in dev and
# CI; by provisioning elsewhere. store.Open refuses to return a pool if this
# role can bypass RLS.
#
# This password is NOT change-me-locally: it must match what app_role.sql sets,
# or `make store-test` fails with an authentication error and the obvious fix is
# to start copying passwords around by hand. Change both together or neither.
APP_DATABASE_URL=postgres://cvap_app_login:cvap_dev_only_app_password@localhost:5432/cvap?sslmode=disable

# --- MinIO (ADR-015: evidence and reports to an S3-compatible store) ---
MINIO_ROOT_USER=cvap
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=cvap-evidence

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
