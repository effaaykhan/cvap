# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Named env.example, without a leading dot, deliberately. The deny rule that
# stops tooling reading real env files is a single glob, `**/.env.*`, and a
# committed template whose name matches it forces the glob to be replaced by an
# enumeration of the names anyone thought of. That enumeration then misses
# .env.prod, .env.ci, .env.backup and whatever gets created next year. One
# filename without a dot is cheaper than a control that decays.
#
# These are DEVELOPMENT credentials for the local Compose stack only. Nothing
# here is a production default: Core holds a map of a customer's weaknesses
# plus credentials to their estate, so a shipped default password is not a
# rough edge, it is the whole compromise.

# --- PostgreSQL (ADR-002: system of record) ---
POSTGRES_USER=cvap
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=cvap
POSTGRES_PORT=5432

# The MIGRATION role. Owns the schema, runs `make migrate-up`, and is the only
# identity that may bypass RLS. Never used by the running application.
DATABASE_URL=postgres://cvap:change-me-locally@localhost:5432/cvap?sslmode=disable

# The APPLICATION role. cvap-core connects as this: a LOGIN role in the cvap_app
# group, holding neither BYPASSRLS nor SUPERUSER, so RLS applies to it (ADR-002).
# Created by internal/store/testdata/app_role.sql (`make app-role`) in dev and
# CI; by provisioning elsewhere. store.Open refuses to return a pool if this
# role can bypass RLS.
#
# This password is NOT change-me-locally: it must match what app_role.sql sets,
# or `make store-test` fails with an authentication error and the obvious fix is
# to start copying passwords around by hand. Change both together or neither.
APP_DATABASE_URL=postgres://cvap_app_login:cvap_dev_only_app_password@localhost:5432/cvap?sslmode=disable

# --- MinIO (ADR-015: evidence and reports to an S3-compatible store) ---
MINIO_ROOT_USER=cvap
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=cvap-evidence

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info

# --- Control plane (cvap-core) ---
# Two listeners, and the split is not cosmetic. Enrollment is the one call a
# scan point makes before it has a certificate, so it cannot sit behind
# RequireAndVerifyClientCert — which Dispatch and Ingest must, because a
# certificate is public and RequireAny would let anyone who has seen one
# impersonate that scan point. RotateCertificate is served on the mTLS port,
# authenticated by the certificate being replaced.
CVAP_CORE_ENROLL_LISTEN=127.0.0.1:8443
CVAP_CORE_MTLS_LISTEN=127.0.0.1:8444

# The trust anchor, as configuration rather than an assumption in the binary
# (ADR-018). Generate a development pair with `make dev-ca`. NEVER a production
# CA key on a developer's disk: Core holds a map of a customer's weaknesses plus
# credentials to their estate, and this key mints identities into that fleet.
# `make dev-ca` writes these two; ./secrets is gitignored.
CVAP_CORE_CA_CERT=./secrets/ca.crt
CVAP_CORE_CA_KEY=./secrets/ca.key

# Names and addresses Core's own server certificate is issued for.
CVAP_CORE_SERVER_HOSTS=localhost,127.0.0.1

# What Core tells a scan point at enrollment. Separate per service so ingest can
# move onto its own hosts without a configuration push to a fleet running
# months-old builds. Default to the mTLS listener when unset.
CVAP_CORE_DISPATCH_ENDPOINT=127.0.0.1:8444
CVAP_CORE_INGEST_ENDPOINT=127.0.0.1:8444
CVAP_CORE_RULEPACKS_ENDPOINT=127.0.0.1:8444

# --- Operator API ---
# A THIRD listener, separate from both gRPC ones and always will be. A scan
# point reaches Core over mTLS with a certificate this deployment issued; an
# operator reaches it over server TLS with a session cookie. One port serving
# both would mean one TLS configuration for two trust models, and the weaker
# one would win.
CVAP_CORE_API_LISTEN=127.0.0.1:8445

# Local password authentication. On-prem only, and this flag is CORE-WIDE
# rather than per tenant — that is the control, not a shortcut. A per-tenant
# switch would let the administrator of a tenant enable password login for
# their own users and so opt out of the deployment operator's SSO policy, using
# a permission granted to them for administering their own tenant. All three of
# this flag, tenants.deployment_mode = 'onprem' and
# tenant_auth_config.method = 'local' are required; none is sufficient.
CVAP_CORE_LOCAL_AUTH=0

# Drops Secure from the session cookie, for local development over plain HTTP.
# Never set this anywhere a real session is issued: a session cookie without
# Secure is a bearer credential a browser will send over cleartext.
CVAP_CORE_API_INSECURE=0

# Session lifetime. Defaults to 8 hours. Twelve is the maximum and the sessions
# table enforces it with a CHECK constraint; Core refuses a larger value at
# startup rather than clamping, so a deployment cannot believe something about
# its own configuration that the database will contradict at login.
CVAP_CORE_SESSION_TTL_SECONDS=28800

# --- Single sign-on (OIDC) ---
# The issuer, client id and claim mapping are PER TENANT, in tenant_auth_config,
# because different customers federate with different providers. What is here is
# the deployment's own posture toward the network those providers live on.
#
# Core fetches discovery, JWKS and the token endpoint from an issuer a tenant
# administrator configured, which is a server-side request forgery primitive
# handed to a customer. Off by default, every fetch must resolve to a public
# address; on, private and loopback are permitted too, for an on-prem deployment
# whose identity provider is on the internal network.
#
# LINK-LOCAL IS REFUSED EITHER WAY. 169.254.169.254 is cloud instance metadata
# and no identity provider belongs there.
CVAP_CORE_OIDC_ALLOW_PRIVATE_ISSUER=0

# Additional trust roots for identity-provider traffic only, as a PEM bundle.
# For an internal provider issued by a private CA. Unset means the system store.
# There is deliberately no setting that disables verification: the authorization
# code travels in the token exchange.
CVAP_CORE_OIDC_CA_BUNDLE=

# --- Scan point (cvap-scanpoint) ---
# Only the enrollment endpoint is configured; dispatch, ingest and rule packs
# come back in EnrollResponse.
CVAP_SP_ENROLL_ENDPOINT=127.0.0.1:8443
CVAP_SP_CA_BUNDLE=./secrets/ca.crt

# The enrollment token, in a FILE rather than an environment variable. A token
# is a bearer credential for a fleet identity: an environment variable sits in
# /proc/<pid>/environ for the life of the process, is inherited by every child —
# including engine processes, which must never see it — and lands in any crash
# report that dumps the environment. Read once and zeroised.
CVAP_SP_ENROLLMENT_TOKEN_FILE=./secrets/enrollment-token

# The private key, certificate, CA chain and identity file live here, and
# nothing else ever does. Created 0700; the key is 0600. Credential material
# from a CredentialGrant is memory-only and never written (ADR-020).
CVAP_SP_DATA_DIR=/var/lib/cvap-scanpoint

# The engine process the runtime hosts (ADR-027).
# Engine binaries this scan point may host, comma-separated (ADR-027).
#
# A list of PATHS, not a kind=path map: each binary reports what it is through
# -capabilities, and Core is told the same at enrolment, so an operator label
# would be a second statement of one fact — free to disagree, with the runtime
# believing the wrong one. The runtime refuses to start if two binaries claim
# the same engine kind.
CVAP_SP_ENGINE_BINARIES=./bin/cvap-engine-noop

# The signed fingerprint corpus (ADR-019, ADR-048), and the ed25519 public key
# it must verify against.
#
# Optional together. Absent means service identification falls back to the
# built-in minimum — banner matching only, no probes — which the scan point
# reports upstream rather than pretending to full coverage. Setting the pack
# without the key is refused at startup: a pack with no key to check it is an
# unsigned pack, and ADR-019 says a scan point refuses one.
#
# The pack supplies patterns and payloads. What may actually be SENT is a closed
# policy in the runtime that the pack cannot widen — no probe to a port where
# bytes are not inert, a payload bound, none in safe mode, none at a fragile
# target. Violations are dropped and reported, never silently trimmed.
CVAP_SP_FINGERPRINT_PACK=
CVAP_SP_FINGERPRINT_KEY=

# --- Discovery engine ---
# Ports the discovery engine scans, comma-separated. Unset takes its default
# set (~180, covering every service the MVP's finding rules reason about; the
# full top-1000 is a data file, see docs/execution-plan.md 6.5).
#
# A scan parameter, not a safety control — the ceilings that bound what the
# engine may do come from the runtime's allocation (ADR-024, ADR-027), and a
# malformed entry here is skipped rather than failing the job.
CVAP_ENGINE_DISCOVERY_PORTS=

# Operator display only. Self-asserted, authenticates nothing, selects no zone
# and no policy. Defaults to the OS hostname.
CVAP_SP_HOSTNAME=
