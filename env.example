# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Named env.example, without a leading dot, deliberately. The deny rule that
# stops tooling reading real env files is a single glob, `**/.env.*`, and a
# committed template whose name matches it forces the glob to be replaced by an
# enumeration of the names anyone thought of. That enumeration then misses
# .env.prod, .env.ci, .env.backup and whatever gets created next year. One
# filename without a dot is cheaper than a control that decays.
#
# These are DEVELOPMENT credentials for the local Compose stack only. Nothing
# here is a production default: Core holds a map of a customer's weaknesses
# plus credentials to their estate, so a shipped default password is not a
# rough edge, it is the whole compromise.

# --- PostgreSQL (ADR-002: system of record) ---
POSTGRES_USER=cvap
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=cvap
POSTGRES_PORT=5432

# The MIGRATION role. Owns the schema, runs `make migrate-up`, and is the only
# identity that may bypass RLS. Never used by the running application.
DATABASE_URL=postgres://cvap:change-me-locally@localhost:5432/cvap?sslmode=disable

# The APPLICATION role. cvap-core connects as this: a LOGIN role in the cvap_app
# group, holding neither BYPASSRLS nor SUPERUSER, so RLS applies to it (ADR-002).
# Created by internal/store/testdata/app_role.sql (`make app-role`) in dev and
# CI; by provisioning elsewhere. store.Open refuses to return a pool if this
# role can bypass RLS.
#
# This password is NOT change-me-locally: it must match what app_role.sql sets,
# or `make store-test` fails with an authentication error and the obvious fix is
# to start copying passwords around by hand. Change both together or neither.
APP_DATABASE_URL=postgres://cvap_app_login:cvap_dev_only_app_password@localhost:5432/cvap?sslmode=disable

# --- MinIO (ADR-015: evidence and reports to an S3-compatible store) ---
MINIO_ROOT_USER=cvap
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=cvap-evidence

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info

# --- Control plane (cvap-core) ---
# Two listeners, and the split is not cosmetic. Enrollment is the one call a
# scan point makes before it has a certificate, so it cannot sit behind
# RequireAndVerifyClientCert — which Dispatch and Ingest must, because a
# certificate is public and RequireAny would let anyone who has seen one
# impersonate that scan point. RotateCertificate is served on the mTLS port,
# authenticated by the certificate being replaced.
CVAP_CORE_ENROLL_LISTEN=127.0.0.1:8443
CVAP_CORE_MTLS_LISTEN=127.0.0.1:8444

# The trust anchor, as configuration rather than an assumption in the binary
# (ADR-018). Generate a development pair with `make dev-ca`. NEVER a production
# CA key on a developer's disk: Core holds a map of a customer's weaknesses plus
# credentials to their estate, and this key mints identities into that fleet.
# `make dev-ca` writes these two; ./secrets is gitignored.
CVAP_CORE_CA_CERT=./secrets/ca.crt
CVAP_CORE_CA_KEY=./secrets/ca.key

# Names and addresses Core's own server certificate is issued for.
CVAP_CORE_SERVER_HOSTS=localhost,127.0.0.1

# What Core tells a scan point at enrollment. Separate per service so ingest can
# move onto its own hosts without a configuration push to a fleet running
# months-old builds. Default to the mTLS listener when unset.
CVAP_CORE_DISPATCH_ENDPOINT=127.0.0.1:8444
CVAP_CORE_INGEST_ENDPOINT=127.0.0.1:8444
CVAP_CORE_RULEPACKS_ENDPOINT=127.0.0.1:8444

# --- Scan point (cvap-scanpoint) ---
# Only the enrollment endpoint is configured; dispatch, ingest and rule packs
# come back in EnrollResponse.
CVAP_SP_ENROLL_ENDPOINT=127.0.0.1:8443
CVAP_SP_CA_BUNDLE=./secrets/ca.crt

# The enrollment token, in a FILE rather than an environment variable. A token
# is a bearer credential for a fleet identity: an environment variable sits in
# /proc/<pid>/environ for the life of the process, is inherited by every child —
# including engine processes, which must never see it — and lands in any crash
# report that dumps the environment. Read once and zeroised.
CVAP_SP_ENROLLMENT_TOKEN_FILE=./secrets/enrollment-token

# The private key, certificate, CA chain and identity file live here, and
# nothing else ever does. Created 0700; the key is 0600. Credential material
# from a CredentialGrant is memory-only and never written (ADR-020).
CVAP_SP_DATA_DIR=/var/lib/cvap-scanpoint

# The engine process the runtime hosts (ADR-027).
CVAP_SP_ENGINE_BINARY=./bin/cvap-engine-noop

# Operator display only. Self-asserted, authenticates nothing, selects no zone
# and no policy. Defaults to the OS hostname.
CVAP_SP_HOSTNAME=
